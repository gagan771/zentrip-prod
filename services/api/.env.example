# Copy to .env. Never commit .env.

DATABASE_URL=postgresql+asyncpg://zentrip:zentrip@localhost:5432/zentrip
REDIS_URL=redis://localhost:6379/0

# Generate a real one for anything beyond local dev: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated. Get these from Google Cloud Console > APIs & Services > Credentials.
# "Continue with Google" returns 503 until this is set to real client ID(s).
GOOGLE_CLIENT_IDS=

# Itinerary generation defaults to OpenRouter's free-model router.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Zentrip

# Optional direct Claude adapter. Set LLM_PROVIDER=anthropic to use it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Twilio outbound onboarding call. PUBLIC_BASE_URL must be public to Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
