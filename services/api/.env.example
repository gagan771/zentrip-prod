# Copy to .env. Never commit .env.

DATABASE_URL=postgresql+asyncpg://zentrip:zentrip@localhost:5432/zentrip
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=
KNOWLEDGE_TELEMETRY_RETENTION_DAYS=90
ALLOW_DEMO_PROVIDER_DATA=true
VOICE_USE_SHARED_GATEWAY=true

# Generate a real one for anything beyond local dev: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated. Get these from Google Cloud Console > APIs & Services > Credentials.
# "Continue with Google" returns 503 until this is set to real client ID(s).
GOOGLE_CLIENT_IDS=

# Itinerary generation defaults to OpenRouter's free-model router.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Zentrip

# Optional direct Claude adapter. Set LLM_PROVIDER=anthropic to use it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Camera OCR / landmark ID. Use a vision-capable OpenRouter model for menu translation.
OPENROUTER_VISION_MODEL=

# Paid streaming STT. Put every free-tier key in SARVAM_API_KEYS; the API rotates on rate limits.
SARVAM_API_KEY=
SARVAM_API_KEYS=
SARVAM_RATE_LIMIT_COOLDOWN_SECONDS=90
# Sarvam Voice Agent (Companion). Same key as STT. Never put these in the Expo app.
SARVAM_VOICE_APP_ID=
SARVAM_VOICE_ORG_ID=
SARVAM_VOICE_WORKSPACE_ID=
# Optional. 0 = latest committed version.
SARVAM_VOICE_APP_VERSION=0
# Optional override (English, Hindi, ...). Blank = follow the signed-in user's language.
SARVAM_VOICE_LANGUAGE=
SARVAM_VOICE_MAX_SECONDS=480
# Optional Deepgram realtime STT. When present, the mobile shared-gateway path prefers it.
DEEPGRAM_API_KEY=
VOICE_LIVE_ENABLED=true
VOICE_STT_BCP47=en-IN

# Voice STT: tiny+cpu is the low-latency default. Use base.en + cuda only if the GPU stack works.
VOICE_STT_MODEL=tiny
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
VOICE_STT_BEAM_SIZE=1
VOICE_STT_LANGUAGE=en

# Twilio outbound onboarding call. PUBLIC_BASE_URL must be public HTTPS (ngrok/cloudflare tunnel locally).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PUBLIC_BASE_URL=
STAFF_EMAILS=
