# Copy this file to services/api/.env on the Oracle VM and fill every secret.
DOMAIN=api.example.com
APP_ENV=staging
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret

ALLOW_DEMO_PROVIDER_DATA=false
VOICE_USE_SHARED_GATEWAY=true
VOICE_LIVE_ENABLED=true

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

SARVAM_API_KEY=
SARVAM_API_KEYS=
DEEPGRAM_API_KEY=

# Needed only for direct LiveKit web/native agent mode. Shared gateway voice uses Sarvam STT.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional integrations.
GOOGLE_CLIENT_IDS=
STAFF_EMAILS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
