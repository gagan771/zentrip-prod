# Copy to .env. Never commit .env.

# LiveKit Cloud (or local ws://livekit:7880 if you self-host)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=flux-brittany-en

# OpenRouter — tool-capable model (Nvidia :free 404s on tools)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge

# Redis
REDIS_URL=redis://redis:6379

# Agent
AGENT_NAME=Zenny
MAX_HISTORY_TURNS=6
RAG_TOP_K=4
KNOWLEDGE_DIR=/app/knowledge
EMBEDDING_MODEL=
# Published claims from FastAPI. Docker: http://host.docker.internal:8001
ZENTRIP_API_URL=
