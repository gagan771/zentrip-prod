# Copy this file to .env and fill in real values. Never commit .env.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time — do not put
# secrets here. Real secrets (Twilio, Deepgram, ElevenLabs, Anthropic keys, DB
# credentials) live server-side only, in the backend service's own env, never
# in this mobile app.

# Base URL of the backend BFF / Agent Gateway (see 00-app-shell-and-integration-architecture.md).
# Desktop/web: http://localhost:8000
# Android emulator: http://10.0.2.2:8000
# Physical device: use your computer's LAN address and start uvicorn with --host 0.0.0.0,
# e.g. http://192.168.x.x:8000. Never put secrets in this file.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# "Web application" OAuth client ID from Google Cloud Console > APIs & Services > Credentials.
# Required for the "Continue with Google" button (lib/auth.ts) to do anything. The backend
# needs the SAME id in its own GOOGLE_CLIENT_IDS (services/api/.env) so it accepts the token.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
